@model IEnumerable<Lab4_MVC_EFCore.Models.Learner>
@{ ViewData["Title"] = "Learner List"; }
<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
    <h1 class="page-title mb-0">Learner List</h1>
    <form asp-action="Index" method="get" class="d-flex search-form"><input name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Tìm tên hoặc ngành..." /><button class="btn btn-primary" type="submit">Tìm</button></form>
</div>
@if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
<div class="row g-3"><aside class="col-md-3"><div class="card p-2"><h5 class="px-2 pt-2">Chuyên ngành</h5>@await Component.InvokeAsync("Major")</div></aside>
<div class="col-md-9"><div class="table-responsive card shadow-sm border-0" id="content">@await Html.PartialAsync("LearnerTable", Model)</div><div class="mt-3"><a asp-action="Create" class="btn btn-primary">Create New Student</a></div></div></div>
@section Scripts {
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
$(document).on('click', '.major-filter', function (e) {
    e.preventDefault();
    const id = $(this).closest('li').attr('id');
    $.ajax({ url: '@Url.Action("LearnerByMajorID", "Learner")', data: { mid: id }, success: function (response) { $('#content').html(response); } });
});
</script>
}
