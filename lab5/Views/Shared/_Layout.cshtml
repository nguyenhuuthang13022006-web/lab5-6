<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-dark topbar">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Learner" asp-action="Index">Management System</a>
            <span class="text-white-50">Data Access · Entity Framework Core</span>
        </div>
    </nav>
    <div class="app-layout">
        <aside class="sidebar">
            <div class="menu-label">CORE</div>
            <a asp-controller="Learner" asp-action="Index">▦ &nbsp; Learners</a>
            <div class="menu-label mt-4">DATA</div>
            <a asp-controller="Learner" asp-action="Create">＋ &nbsp; Create Learner</a>
        </aside>
        <main class="content">
            @RenderBody()
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
