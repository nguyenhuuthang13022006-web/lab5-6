@model Learner
<h1>Create Learner</h1><form asp-action="Create" method="post" class="edit-form"><label>Tên<input asp-for="Name" required /></label><label>Họ<input asp-for="Surname" required /></label><label>Ngành<select asp-for="Major"><option>IT</option><option>Economics</option><option>Mathematics</option></select></label><label>Ngày nhập học<input asp-for="EnrollDate" type="datetime-local" /></label><button class="button">Create</button><a asp-action="Index">Cancel</a></form>
